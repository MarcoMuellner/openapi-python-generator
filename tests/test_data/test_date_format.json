{
  "openapi": "3.0.0",
  "info": {
    "title": "Date Format Test API",
    "version": "1.0.0"
  },
  "paths": {
    "/person": {
      "get": {
        "operationId": "get_person",
        "responses": {
          "200": {
            "description": "Person details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Person"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Person": {
        "type": "object",
        "required": ["name", "birth_date", "created_at"],
        "properties": {
          "name": {
            "type": "string"
          },
          "birth_date": {
            "type": "string",
            "format": "date"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
